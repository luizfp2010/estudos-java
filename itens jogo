		Scanner leia = new Scanner(System.in);
		
		int quantidade1;
		double preço1;
		double valor;
		int quantidade2;
		double preço2;
		double total1;
		double total2;
		double total10;
		double valort;
		System.out.printf("quantidade item 1: ");
